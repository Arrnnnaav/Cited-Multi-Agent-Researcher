# --- LLM for classify / decompose / synthesis / judge ---
LLM_PROVIDER=gemini                 # gemini | openai_compat
GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM_PROVIDER=openai_compat: NVIDIA NIM first, OpenRouter free models as fallback.
NVIDIA_API_KEY=
NIM_MODELS=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b,deepseek-ai/deepseek-v4.1-flash
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# --- Web search ---
SEARCH_PROVIDER=tavily              # tavily | gemini (default: tavily if key set)
TAVILY_API_KEY=

# --- Optional infra ---
REDIS_URL=redis://127.0.0.1:6379/1
SUBAGENT_CAP=5
