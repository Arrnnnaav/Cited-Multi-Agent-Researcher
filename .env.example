# --- LLM for classify / decompose / synthesis / judge ---
LLM_PROVIDER=gemini                 # gemini | openai_compat
GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible gateway (used when LLM_PROVIDER=openai_compat)
# OpenRouter:  https://openrouter.ai/api/v1
# NVIDIA NIM:  https://integrate.api.nvidia.com/v1
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free

# --- Web search ---
SEARCH_PROVIDER=tavily              # tavily | gemini (default: tavily if key set)
TAVILY_API_KEY=

# --- Optional infra ---
REDIS_URL=redis://127.0.0.1:6379/1
SUBAGENT_CAP=5
